{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "camel": {
      "type": "local",
      "command": [
        "jbang",
        "--repos", "{{CAMEL_MCP_REPOS}}",
        "-Dcamel.catalog.repos={{CAMEL_CATALOG_REPOS}}",
        "-Dquarkus.log.level=WARN",
        "org.apache.camel:camel-jbang-mcp:{{CAMEL_MCP_VERSION}}:runner"
      ],
      "enabled": true
    },
    "camel-knowledge": {
      "type": "local",
      "command": [
        "jbang",
        "--repos", "{{KNOWLEDGE_MCP_REPOS}}",
        "-Dquarkus.log.level=WARN",
        "io.github.luigidemasi:camel-kit-knowledge-mcp:{{KNOWLEDGE_VERSION}}:runner"
      ],
      "enabled": true
    },
    "camel-graph": {
      "type": "local",
      "command": [
        "jbang",
        "--repos", "{{GRAPH_MCP_REPOS}}",
        "-Dquarkus.log.level=WARN",
        "io.github.luigidemasi:camel-kit-graph-mcp:{{GRAPH_MCP_VERSION}}:runner"
      ],
      "enabled": true
    }
  }
}
