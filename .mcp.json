{
  "mcpServers": {
    "camel": {
      "command": "jbang",
      "args": [
        "--repos", "redhat=https://maven.repository.redhat.com/ga/,apache_snap=https://repository.apache.org/snapshots,apache=https://repository.apache.org/content/groups/public/",
        "-Dcamel.catalog.repos=https://maven.repository.redhat.com/ga/",
        "-Dquarkus.log.level=WARN",
        "org.apache.camel:camel-jbang-mcp:4.19.0-SNAPSHOT:runner"
      ],
      "description": "Apache Camel MCP Server - Component catalog, validation, and security analysis"
    },
    "camel-knowledge": {
      "command": "jbang",
      "args": [
        "--repos", "redhat=https://maven.repository.redhat.com/ga/",
        "-Dquarkus.log.level=WARN",
        "io.github.luigidemasi:camel-kit-knowledge-mcp:0.0.1-SNAPSHOT:runner"
      ],
      "description": "camel-kit Knowledge Server - documentation search for Red Hat Build of Apache Camel"
    }
  }
}
