<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.luigidemasi</groupId>
        <artifactId>camel-kit</artifactId>
        <version>0.3.2-SNAPSHOT</version>
    </parent>

    <artifactId>camel-kit-standalone</artifactId>
    <name>Camel Kit :: Standalone</name>
    <description>All-in-one portable executable for Camel Kit — requires only Java 17+</description>

    <properties>
        <knowledge.mcp.version>${project.version}</knowledge.mcp.version>
        <citrus.version>4.9.2</citrus.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.luigidemasi</groupId>
            <artifactId>camel-kit-core</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>

            <!-- 1. Copy MCP runner JARs + extract Citrus schemas -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <!-- Copy MCP runner JARs as opaque resources (not unpacked) -->
                    <execution>
                        <id>copy-mcp-jars</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.apache.camel</groupId>
                                    <artifactId>camel-jbang-mcp</artifactId>
                                    <version>${camel.mcp.version}</version>
                                    <classifier>runner</classifier>
                                    <type>jar</type>
                                    <destFileName>camel-jbang-mcp-runner.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.github.luigidemasi</groupId>
                                    <artifactId>camel-kit-knowledge-mcp</artifactId>
                                    <version>${knowledge.mcp.version}</version>
                                    <classifier>runner</classifier>
                                    <type>jar</type>
                                    <destFileName>camel-kit-knowledge-mcp-runner.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                            <outputDirectory>${project.build.directory}/classes/mcp-jars</outputDirectory>
                        </configuration>
                    </execution>
                    <!-- Extract Citrus schemas from catalog JAR -->
                    <execution>
                        <id>unpack-citrus-schemas</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>unpack</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.citrusframework</groupId>
                                    <artifactId>citrus-catalog-schema</artifactId>
                                    <version>${citrus.version}</version>
                                    <type>jar</type>
                                </artifactItem>
                            </artifactItems>
                            <includes>org/citrusframework/schema/citrus/${citrus.version}/**</includes>
                            <outputDirectory>${project.build.directory}/citrus-unpack</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 2. Move extracted Citrus schemas to the correct resource path -->
            <plugin>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>relocate-citrus-schemas</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <mkdir dir="${project.build.directory}/classes/citrus-schemas/${citrus.version}"/>
                                <copy todir="${project.build.directory}/classes/citrus-schemas/${citrus.version}">
                                    <fileset dir="${project.build.directory}/citrus-unpack/org/citrusframework/schema/citrus/${citrus.version}">
                                        <include name="**/*"/>
                                    </fileset>
                                </copy>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 3. Create uber JAR with all dependencies -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>io.github.luigidemasi.camelkit.standalone.StandaloneMain</mainClass>
                                </transformer>
                                <!-- Merge META-INF/services for JLine, Jackson, etc. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <!-- Exclude signing artifacts from dependencies -->
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

</project>
