#!/bin/sh
#
# camel-kit — wrapper script for the Camel Kit standalone JAR
#
# Usage: ./camel-kit init my-project --ai bob
#
# Place this script in the same directory as camel-kit-standalone-*.jar,
# or set CAMEL_KIT_HOME to the directory containing the JAR.
#

set -e

# Resolve the directory where this script lives (follow symlinks)
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Allow override via CAMEL_KIT_HOME
CAMEL_KIT_HOME="${CAMEL_KIT_HOME:-$SCRIPT_DIR}"

# Find the JAR
JAR=$(find "$CAMEL_KIT_HOME" -maxdepth 1 -name 'camel-kit-standalone-*.jar' -not -name 'original-*' 2>/dev/null | head -1)

if [ -z "$JAR" ]; then
    echo "Error: camel-kit-standalone-*.jar not found in $CAMEL_KIT_HOME" >&2
    echo "Download it or set CAMEL_KIT_HOME to the directory containing the JAR." >&2
    exit 1
fi

# Check Java is available
if ! command -v java >/dev/null 2>&1; then
    echo "Error: Java not found. Camel Kit requires Java 17 or later." >&2
    exit 1
fi

exec java ${CAMEL_KIT_OPTS:-} -jar "$JAR" "$@"
