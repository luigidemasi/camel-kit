<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.luigidemasi</groupId>
        <artifactId>camel-kit</artifactId>
        <version>0.3.2-SNAPSHOT</version>
    </parent>

    <artifactId>camel-kit-ship-resolver</artifactId>
    <name>Camel Kit :: Ship Resolver</name>
    <description>Classloader-isolated Maven Resolver for Ship evidence</description>

    <dependencies>
        <dependency>
            <groupId>org.apache.maven.resolver</groupId>
            <artifactId>maven-resolver-supplier</artifactId>
            <version>${maven.resolver.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.maven.resolver</groupId>
            <artifactId>maven-resolver-util</artifactId>
            <version>${maven.resolver.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-resolver-provider</artifactId>
            <version>${maven.provider.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-model-builder</artifactId>
            <version>${maven.provider.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-nop</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${maven.jar.plugin.version}</version>
                <configuration>
                    <forceCreation>true</forceCreation>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${maven.shade.plugin.version}</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>true</createDependencyReducedPom>
                            <dependencyReducedPomLocation>${project.build.directory}/dependency-reduced-pom.xml</dependencyReducedPomLocation>
                            <useDependencyReducedPomInJar>true</useDependencyReducedPomInJar>
                            <promoteTransitiveDependencies>false</promoteTransitiveDependencies>
                            <minimizeJar>false</minimizeJar>
                            <filters>
                                <filter>
                                    <artifact>org.apache.maven:maven-resolver-provider</artifact>
                                    <excludes>
                                        <exclude>org/apache/maven/repository/internal/MavenResolverModule*.class</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>org.apache.maven.resolver:maven-resolver-impl</artifact>
                                    <excludes>
                                        <exclude>org/eclipse/aether/impl/guice/**</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>org.eclipse.sisu:org.eclipse.sisu.inject</artifact>
                                    <includes>
                                        <include>org/eclipse/sisu/Nullable.class</include>
                                        <include>org/eclipse/sisu/Typed.class</include>
                                    </includes>
                                </filter>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/DEPENDENCIES</exclude>
                                        <exclude>META-INF/sisu/**</exclude>
                                        <exclude>META-INF/versions/**/module-info.class</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <relocations>
                                <!--
                                    Shade 3.6.1 rewrites bytecode inside multi-release classes but does not
                                    strip the META-INF/versions prefix before mapping their entry names. Keep
                                    Plexus Utils' Java 9-11 implementations loadable under the relocated name.
                                -->
                                <relocation>
                                    <pattern>META-INF.versions.9.org.codehaus</pattern>
                                    <shadedPattern>META-INF.versions.9.io.github.luigidemasi.camelkit.ship.resolver.internal.org.codehaus</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>META-INF.versions.10.org.codehaus</pattern>
                                    <shadedPattern>META-INF.versions.10.io.github.luigidemasi.camelkit.ship.resolver.internal.org.codehaus</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>META-INF.versions.11.org.codehaus</pattern>
                                    <shadedPattern>META-INF.versions.11.io.github.luigidemasi.camelkit.ship.resolver.internal.org.codehaus</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.eclipse</pattern>
                                    <shadedPattern>io.github.luigidemasi.camelkit.ship.resolver.internal.org.eclipse</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.apache</pattern>
                                    <shadedPattern>io.github.luigidemasi.camelkit.ship.resolver.internal.org.apache</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.codehaus</pattern>
                                    <shadedPattern>io.github.luigidemasi.camelkit.ship.resolver.internal.org.codehaus</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.slf4j</pattern>
                                    <shadedPattern>io.github.luigidemasi.camelkit.ship.resolver.internal.org.slf4j</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.sonatype</pattern>
                                    <shadedPattern>io.github.luigidemasi.camelkit.ship.resolver.internal.org.sonatype</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.objectweb</pattern>
                                    <shadedPattern>io.github.luigidemasi.camelkit.ship.resolver.internal.org.objectweb</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.google</pattern>
                                    <shadedPattern>io.github.luigidemasi.camelkit.ship.resolver.internal.com.google</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>javax.inject</pattern>
                                    <shadedPattern>io.github.luigidemasi.camelkit.ship.resolver.internal.javax.inject</shadedPattern>
                                </relocation>
                            </relocations>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer" />
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer" />
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <manifestEntries>
                                        <Multi-Release>true</Multi-Release>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven.surefire.plugin.version}</version>
                <executions>
                    <execution>
                        <id>verify-resolver-isolation</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>**/*IsolationIT.java</include>
                            </includes>
                            <systemPropertyVariables>
                                <ship.resolver.jar>${project.build.directory}/${project.build.finalName}.jar</ship.resolver.jar>
                                <ship.resolver.version>${maven.resolver.version}</ship.resolver.version>
                                <ship.maven.provider.version>${maven.provider.version}</ship.maven.provider.version>
                                <ship.slf4j.version>${slf4j.version}</ship.slf4j.version>
                            </systemPropertyVariables>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
