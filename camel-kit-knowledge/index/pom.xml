<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.luigidemasi</groupId>
        <artifactId>camel-kit-knowledge</artifactId>
        <version>0.3.2-SNAPSHOT</version>
    </parent>

    <artifactId>camel-kit-knowledge-index</artifactId>
    <name>Camel Kit :: Knowledge :: Index</name>
    <description>Pre-built Lucene knowledge index — independently versioned artifact</description>

    <!-- Version is overridden at build time: -Drevision=202603131454 -->
    <version>${revision}</version>

    <properties>
        <revision>0.0.0-LOCAL</revision>
    </properties>

    <!-- No Java code — only index resources -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!-- Rebuild the knowledge index from source documents.
             Usage: mvn package -pl camel-kit-knowledge/index -Prebuild-index -Drevision=$(date +%Y%m%d%H%M) -am
             Requires Docker for the Docling container. -->
        <profile>
            <id>rebuild-index</id>
            <dependencies>
                <!-- Indexer classes needed to run IndexerMain -->
                <dependency>
                    <groupId>io.github.luigidemasi</groupId>
                    <artifactId>camel-kit-knowledge-indexer</artifactId>
                    <version>${project.parent.version}</version>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <!-- Start Docling container and wait for readiness -->
                            <execution>
                                <id>start-docling</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>-c</argument>
                                        <argument>
docker rm -f camel-kit-docling 2>/dev/null || true
docker run -d --name camel-kit-docling -p 5001:5001 quay.io/docling-project/docling-serve:latest
echo "Waiting for Docling to start..."
for i in $(seq 1 60); do
  if curl -sf http://localhost:5001/health > /dev/null 2>&amp;1; then
    echo "Docling is ready."
    exit 0
  fi
  sleep 2
done
echo "ERROR: Docling failed to start within 120s"
docker logs camel-kit-docling
docker rm -f camel-kit-docling 2>/dev/null
exit 1
                                        </argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <!-- Run the indexer to generate the Lucene index -->
                            <execution>
                                <id>build-index</id>
                                <phase>process-classes</phase>
                                <goals>
                                    <goal>java</goal>
                                </goals>
                                <configuration>
                                    <mainClass>io.github.luigidemasi.camelkit.knowledge.indexer.IndexerMain</mainClass>
                                    <systemProperties>
                                        <systemProperty>
                                            <key>index.output</key>
                                            <value>${project.basedir}/src/main/resources/knowledge-index</value>
                                        </systemProperty>
                                        <systemProperty>
                                            <key>index.resources</key>
                                            <value>${project.basedir}/../indexer/src/main/resources</value>
                                        </systemProperty>
                                        <systemProperty>
                                            <key>index.cache</key>
                                            <value>${project.build.directory}/doc-cache</value>
                                        </systemProperty>
                                        <systemProperty>
                                            <key>docling.url</key>
                                            <value>http://localhost:5001</value>
                                        </systemProperty>
                                    </systemProperties>
                                </configuration>
                            </execution>
                            <!-- Stop Docling container after index is built -->
                            <execution>
                                <id>stop-docling</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>-c</argument>
                                        <argument>docker rm -f camel-kit-docling 2>/dev/null || true</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
