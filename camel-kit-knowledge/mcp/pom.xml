<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.luigidemasi</groupId>
        <artifactId>camel-kit-knowledge</artifactId>
        <version>0.3.2-SNAPSHOT</version>
    </parent>

    <artifactId>camel-kit-knowledge-mcp</artifactId>
    <name>Camel Kit :: Knowledge :: MCP</name>
    <description>MCP server for camel-kit knowledge layer — domain-specific search tools backed by Lucene</description>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.redhat.quarkus.platform</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${quarkus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.redhat.quarkus.platform</groupId>
                <artifactId>quarkus-mcp-server-bom</artifactId>
                <version>${quarkus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Quarkus MCP Server -->
        <dependency>
            <groupId>io.quarkiverse.mcp</groupId>
            <artifactId>quarkus-mcp-server-stdio</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkiverse.mcp</groupId>
            <artifactId>quarkus-mcp-server-sse</artifactId>
        </dependency>

        <!-- Knowledge schema (shared types) -->
        <dependency>
            <groupId>io.github.luigidemasi</groupId>
            <artifactId>camel-kit-knowledge-schema</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Embedding provider for semantic search -->
        <dependency>
            <groupId>io.github.luigidemasi</groupId>
            <artifactId>camel-kit-knowledge-embedding</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Lucene search -->
        <dependency>
            <groupId>org.apache.lucene</groupId>
            <artifactId>lucene-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.lucene</groupId>
            <artifactId>lucene-queryparser</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.lucene</groupId>
            <artifactId>lucene-analysis-common</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>com.redhat.quarkus.platform</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.version}</version>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Download Granite embedding ONNX model (Q8 quantized, external data format) -->
            <plugin>
                <groupId>com.googlecode.maven-download-plugin</groupId>
                <artifactId>download-maven-plugin</artifactId>
                <version>1.12.1</version>
                <executions>
                    <execution>
                        <id>download-onnx-model-graph</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>wget</goal>
                        </goals>
                        <configuration>
                            <url>https://huggingface.co/onnx-community/granite-embedding-small-english-r2-ONNX/resolve/main/onnx/model_quantized.onnx</url>
                            <outputDirectory>${project.basedir}/src/main/resources/models</outputDirectory>
                            <outputFileName>model_quantized.onnx</outputFileName>
                            <skipCache>true</skipCache>
                            <overwrite>false</overwrite>
                        </configuration>
                    </execution>
                    <execution>
                        <id>download-onnx-model-data</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>wget</goal>
                        </goals>
                        <configuration>
                            <url>https://huggingface.co/onnx-community/granite-embedding-small-english-r2-ONNX/resolve/main/onnx/model_quantized.onnx_data</url>
                            <outputDirectory>${project.basedir}/src/main/resources/models</outputDirectory>
                            <outputFileName>model_quantized.onnx_data</outputFileName>
                            <skipCache>true</skipCache>
                            <overwrite>false</overwrite>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Separate forks to avoid native library classloader conflicts
                         between Quarkus tests and plain JUnit tests using ONNX Runtime -->
                    <reuseForks>false</reuseForks>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!-- Rebuild the knowledge index from source documents.
             Usage: mvn package -pl camel-kit-knowledge/mcp -Prebuild-index -am
             Requires Docker for the Docling container. -->
        <profile>
            <id>rebuild-index</id>
            <dependencies>
                <!-- Indexer classes needed to run IndexerMain -->
                <dependency>
                    <groupId>io.github.luigidemasi</groupId>
                    <artifactId>camel-kit-knowledge-indexer</artifactId>
                    <version>${project.version}</version>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <!-- Start Docling container and wait for readiness -->
                            <execution>
                                <id>start-docling</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>-c</argument>
                                        <argument>
docker rm -f camel-kit-docling 2>/dev/null || true
docker run -d --name camel-kit-docling -p 5001:5001 quay.io/docling-project/docling-serve:latest
echo "Waiting for Docling to start..."
for i in $(seq 1 60); do
  if curl -sf http://localhost:5001/health > /dev/null 2>&amp;1; then
    echo "Docling is ready."
    exit 0
  fi
  sleep 2
done
echo "ERROR: Docling failed to start within 120s"
docker logs camel-kit-docling
docker rm -f camel-kit-docling 2>/dev/null
exit 1
                                        </argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <!-- Run the indexer to generate the Lucene index -->
                            <execution>
                                <id>build-index</id>
                                <phase>process-classes</phase>
                                <goals>
                                    <goal>java</goal>
                                </goals>
                                <configuration>
                                    <mainClass>io.github.luigidemasi.camelkit.knowledge.indexer.IndexerMain</mainClass>
                                    <systemProperties>
                                        <systemProperty>
                                            <key>index.output</key>
                                            <value>${project.basedir}/src/main/resources/knowledge-index</value>
                                        </systemProperty>
                                        <systemProperty>
                                            <key>index.resources</key>
                                            <value>${project.basedir}/../indexer/src/main/resources</value>
                                        </systemProperty>
                                        <systemProperty>
                                            <key>index.cache</key>
                                            <value>${project.build.directory}/doc-cache</value>
                                        </systemProperty>
                                        <systemProperty>
                                            <key>docling.url</key>
                                            <value>http://localhost:5001</value>
                                        </systemProperty>
                                    </systemProperties>
                                </configuration>
                            </execution>
                            <!-- Stop Docling container after index is built -->
                            <execution>
                                <id>stop-docling</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>-c</argument>
                                        <argument>docker rm -f camel-kit-docling 2>/dev/null || true</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
