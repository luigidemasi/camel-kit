{
  "mcpServers": {
    "camel": {
      "command": "jbang",
      "args": [
        "--repos", "{{CAMEL_MCP_REPOS}}",
        "-Dcamel.catalog.repos={{CAMEL_CATALOG_REPOS}}",
        "-Dquarkus.log.level=WARN",
        "org.apache.camel:camel-jbang-mcp:{{CAMEL_MCP_VERSION}}:runner"
      ],
      "description": "Apache Camel MCP Server - Component catalog, validation, and security analysis"
    },
    "camel-knowledge": {
      "command": "jbang",
      "args": [
        "--repos", "{{KNOWLEDGE_MCP_REPOS}}",
        "-Dquarkus.log.level=WARN",
        "io.github.luigidemasi:camel-kit-knowledge-mcp:{{KNOWLEDGE_VERSION}}:runner"
      ],
      "description": "camel-kit Knowledge Server - documentation search for Red Hat Build of Apache Camel"
    },
    "camel-graph": {
      "command": "jbang",
      "args": [
        "--repos", "{{GRAPH_MCP_REPOS}}",
        "-Dquarkus.log.level=WARN",
        "io.github.luigidemasi:camel-kit-graph-mcp:{{GRAPH_MCP_VERSION}}:runner"
      ],
      "description": "camel-kit Graph Server - project code graph navigation for structural analysis"
    }
  }
}
