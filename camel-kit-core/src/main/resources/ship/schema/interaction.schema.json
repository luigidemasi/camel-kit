        "evidenceDigest": {
          "$ref": "#/$defs/digest"
        },
        "eligibilityPolicyDigest": {
          "$ref": "#/$defs/digest"
        },
        "subjectDigest": {
          "$ref": "#/$defs/digest"
        },
        "decision": {
          "enum": [
            "WAIVE",
            "DENY"
          ]
        },
        "reason": {
          "type": "string",
          "maxLength": 65536
        },
        "controllerObservedProcessPrincipal": {
          "$ref": "#/$defs/reference"
        },
        "declaredCliUiProfile": {
          "$ref": "#/$defs/reference"
        },
        "channel": {
          "$ref": "#/$defs/channel"
        },
        "answeredAt": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "const": "WAIVE"
              }
            },
            "required": [
              "decision"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          },
          "else": {
            "properties": {
              "reason": {
                "maxLength": 0
              }
            }
          }
        }
      ]
    }
