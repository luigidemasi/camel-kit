<?xml version="1.0" encoding="UTF-8"?>
<!--
    POM Template for Apache Camel on Spring Boot.

    INSTRUCTIONS:
    1. Copy this file to your project as pom.xml
    2. Replace ALL placeholders marked with [PLACEHOLDER] brackets
    3. Add your project-specific dependencies in the DEPENDENCIES section
    4. Do NOT change any groupId, artifactId, or version that is NOT a placeholder
    5. Do NOT change the property names
    6. Do NOT add a <parent> element
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- NO <parent> element — the BOM manages all versions -->

    <groupId>[PROJECT_GROUP_ID]</groupId>
    <artifactId>[PROJECT_ARTIFACT_ID]</artifactId>
    <version>[PROJECT_VERSION]</version>
    <packaging>jar</packaging>
    <name>[PROJECT_NAME]</name>

    <properties>
        <!-- BOM version: look up from design spec platformBomVersion -->
        <!-- This is the Camel Spring Boot BOM version -->
        <camel-spring-boot-version>[PLATFORM_BOM_VERSION]</camel-spring-boot-version>
        <!-- Spring Boot plugin version: look up from config property project.springBootVersion -->
        <spring-boot-version>[SPRING_BOOT_VERSION]</spring-boot-version>

        <!-- DO NOT CHANGE these property names -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.target>17</maven.compiler.target>
        <maven.compiler.source>17</maven.compiler.source>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.apache.camel.springboot</groupId>
                <artifactId>camel-spring-boot-bom</artifactId>
                <version>${camel-spring-boot-version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- ==================== BASE DEPENDENCIES ========================= -->
        <!-- Spring Boot and Camel starters — always needed.                  -->
        <!-- ================================================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.camel.springboot</groupId>
            <artifactId>camel-spring-boot-starter</artifactId>
        </dependency>

        <!-- ==================== PROJECT DEPENDENCIES ====================== -->
        <!-- Add your Camel Spring Boot component starters here.              -->
        <!-- Pattern: org.apache.camel.springboot:camel-[component]-starter   -->
        <!-- No <version> tag needed — the BOM manages versions.              -->
        <!-- ================================================================ -->

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.camel</groupId>
            <artifactId>camel-test-spring-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot-version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>openshift</id>
            <properties>
                <jkube.build.switchToDeployment>true</jkube.build.switchToDeployment>
                <jkube-maven-plugin-version>1.19.0</jkube-maven-plugin-version>
            </properties>
            <build>
                <defaultGoal>install</defaultGoal>
                <plugins>
                    <plugin>
                        <groupId>org.eclipse.jkube</groupId>
                        <artifactId>openshift-maven-plugin</artifactId>
                        <version>${jkube-maven-plugin-version}</version>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>resource</goal>
                                    <goal>build</goal>
                                    <goal>apply</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
